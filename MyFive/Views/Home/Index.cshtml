@{
    ViewData["Title"] = "MyFive - Supabase DB 연동";
}

<div class="text-center">
    <h1 class="display-4 fw-bold">MyFive Web App</h1>
    <p class="lead">Supabase (PostgreSQL) 연동 및 Render 배포 프로젝트</p>
</div>

<div class="container my-5">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-header bg-primary text-white">
            <h5 class="card-title mb-0">⚡ Supabase 데이터베이스 연결 테스트</h5>
        </div>
        <div class="card-body text-center">
            <p class="card-text text-muted">
                아래 버튼을 눌러 설정된 Supabase(PostgreSQL) 데이터베이스와의 연결 상태를 실시간으로 확인합니다.
            </p>
            <button id="btnCheckDb" class="btn btn-primary px-4 py-2">
                Supabase 연결 확인
            </button>
            <div id="resultBox" class="mt-4 p-3 rounded d-none" style="text-align: left;">
                <h6 id="statusTitle" class="fw-bold mb-2"></h6>
                <pre id="statusContent" class="mb-0 bg-light p-2 rounded" style="white-space: pre-wrap; font-size: 0.9rem;"></pre>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('btnCheckDb').addEventListener('click', async function () {
        const resultBox = document.getElementById('resultBox');
        const statusTitle = document.getElementById('statusTitle');
        const statusContent = document.getElementById('statusContent');
        const btn = document.getElementById('btnCheckDb');

        btn.disabled = true;
        btn.innerText = '확인 중...';
        resultBox.classList.add('d-none');

        try {
            const response = await fetch('/Home/DbTest');
            const data = await response.json();

            resultBox.classList.remove('d-none', 'alert-success', 'alert-danger');
            if (data.success) {
                resultBox.classList.add('alert', 'alert-success');
                statusTitle.innerText = '✅ 연결 성공';
            } else {
                resultBox.classList.add('alert', 'alert-danger');
                statusTitle.innerText = '❌ 연결 실패';
            }
            statusContent.innerText = JSON.stringify(data, null, 2);
        } catch (err) {
            resultBox.classList.remove('d-none');
            resultBox.classList.add('alert', 'alert-danger');
            statusTitle.innerText = '❌ 통신 오류';
            statusContent.innerText = err.message;
        } finally {
            btn.disabled = false;
            btn.innerText = 'Supabase 연결 확인';
        }
    });
</script>
