@{
    ViewData["Title"] = "MyNetGame - Supabase 연동";
}

<div class="text-center my-4">
    <h1 class="display-4 fw-bold">🎮 MyNetGame</h1>
    <p class="lead text-muted">Supabase (PostgreSQL) 데이터베이스 연동 및 Render 배포</p>
</div>

<div class="container my-4">
    <div class="row g-4">
        <!-- 1. Supabase 연결 테스트 및 테이블 목록 -->
        <div class="col-md-5">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">⚡ Supabase 연결 상태</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small">
                        설정된 Supabase (PostgreSQL) 데이터베이스와의 연결 상태를 실시간으로 테스트합니다.
                    </p>
                    <button id="btnCheckDb" class="btn btn-outline-primary w-100 mb-3">
                        연결 상태 확인
                    </button>
                    <div id="dbStatusAlert" class="alert d-none"></div>

                    <hr />

                    <h6 class="fw-bold mb-2">📁 Supabase 테이블 목록</h6>
                    <button id="btnGetTables" class="btn btn-sm btn-outline-secondary mb-2">테이블 목록 갱신</button>
                    <ul id="tableList" class="list-group small">
                        <li class="list-group-item text-muted">테이블 목록 갱신 버튼을 눌러주세요.</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- 2. five 테이블 실시간 조회 및 추가 -->
        <div class="col-md-7">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">📋 [five] 테이블 실시간 조회</h5>
                    <button id="btnRefreshFives" class="btn btn-sm btn-light">새로고침</button>
                </div>
                <div class="card-body">
                    <!-- 신규 데이터 등록 -->
                    <div class="input-group mb-3">
                        <input type="text" id="inputNote" class="form-control" placeholder="새로운 Note 입력..." />
                        <button id="btnAddFive" class="btn btn-success">추가</button>
                    </div>

                    <!-- 조회 목록 테이블 -->
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 80px;">Id</th>
                                    <th>Note</th>
                                </tr>
                            </thead>
                            <tbody id="fivesTableBody">
                                <tr>
                                    <td colspan="2" class="text-center text-muted py-3">데이터를 불러오는 중입니다...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // 1. Supabase 연결 테스트
    document.getElementById('btnCheckDb').addEventListener('click', async function () {
        const btn = document.getElementById('btnCheckDb');
        const alertBox = document.getElementById('dbStatusAlert');
        btn.disabled = true;
        btn.innerText = '확인 중...';

        try {
            const res = await fetch('/Home/CheckDb');
            const data = await res.json();
            alertBox.classList.remove('d-none', 'alert-success', 'alert-danger');
            if (data.success) {
                alertBox.classList.add('alert-success');
                alertBox.innerHTML = `<b>✅ 성공:</b> ${data.message}`;
            } else {
                alertBox.classList.add('alert-danger');
                alertBox.innerHTML = `<b>❌ 실패:</b> ${data.message}`;
            }
        } catch (err) {
            alertBox.classList.remove('d-none');
            alertBox.classList.add('alert-danger');
            alertBox.innerHTML = `<b>❌ 통신 오류:</b> ${err.message}`;
        } finally {
            btn.disabled = false;
            btn.innerText = '연결 상태 확인';
        }
    });

    // 2. 테이블 목록 조회
    document.getElementById('btnGetTables').addEventListener('click', async function () {
        const list = document.getElementById('tableList');
        list.innerHTML = '<li class="list-group-item text-muted">조회 중...</li>';

        try {
            const res = await fetch('/Home/GetTables');
            const data = await res.json();
            if (data.success && data.tables && data.tables.length > 0) {
                list.innerHTML = data.tables.map(t => `<li class="list-group-item">📊 ${t}</li>`).join('');
            } else {
                list.innerHTML = '<li class="list-group-item text-muted">테이블이 없습니다.</li>';
            }
        } catch (err) {
            list.innerHTML = `<li class="list-group-item text-danger">오류: ${err.message}</li>`;
        }
    });

    // 3. five 테이블 데이터 조회
    async function loadFives() {
        const tbody = document.getElementById('fivesTableBody');
        try {
            const res = await fetch('/Home/GetFives');
            const data = await res.json();
            if (data.success && data.items && data.items.length > 0) {
                tbody.innerHTML = data.items.map(item => `
                    <tr>
                        <td class="fw-bold">${item.id}</td>
                        <td>${item.note || ''}</td>
                    </tr>
                `).join('');
            } else {
                tbody.innerHTML = '<tr><td colspan="2" class="text-center text-muted py-3">데이터가 없습니다.</td></tr>';
            }
        } catch (err) {
            tbody.innerHTML = `<tr><td colspan="2" class="text-center text-danger py-3">조회 실패: ${err.message}</td></tr>`;
        }
    }

    // 4. 데이터 추가
    document.getElementById('btnAddFive').addEventListener('click', async function () {
        const input = document.getElementById('inputNote');
        const note = input.value.trim();
        if (!note) return;

        try {
            const res = await fetch('/Home/AddFive', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ note })
            });
            const data = await res.json();
            if (data.success) {
                input.value = '';
                loadFives();
            } else {
                alert('등록 실패: ' + data.message);
            }
        } catch (err) {
            alert('통신 오류: ' + err.message);
        }
    });

    document.getElementById('btnRefreshFives').addEventListener('click', loadFives);
    document.addEventListener('DOMContentLoaded', function () {
        loadFives();
    });
</script>
