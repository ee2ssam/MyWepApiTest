@{
    ViewData["Title"] = "MyNetGame - 게임 프로토콜 API 대시보드";
}

<div class="text-center my-4">
    <h1 class="display-4 fw-bold">🎮 MyNetGame Web API</h1>
    <p class="lead text-muted">Supabase 저장 프로시저 기반 게임 프로토콜 (1101 ~ 1105) 대시보드</p>
</div>

<div class="container my-4">
    <!-- 1. 연결 정보 안내 -->
    <div class="alert alert-info d-flex justify-content-between align-items-center mb-4">
        <div>
            <strong>🔗 프로토콜 목록:</strong>
            <span class="badge bg-primary">1101: 로그인</span>
            <span class="badge bg-success">1102: 유저등록</span>
            <span class="badge bg-info text-dark">1103: 유저정보</span>
            <span class="badge bg-warning text-dark">1104: 레벨업</span>
            <span class="badge bg-danger">1105: 골드추가</span>
            <span class="badge bg-secondary">GET /api/ping</span>
        </div>
        <div>
            <button id="btnPing" class="btn btn-sm btn-outline-success me-1">⚡ 서버 핑 (/api/ping)</button>
            <button id="btnCheckDb" class="btn btn-sm btn-outline-primary">DB 연결 확인</button>
        </div>
    </div>
    <div id="dbAlert" class="alert d-none"></div>

    <!-- 2. 프로토콜 테스트 카드 2열 그리드 -->
    <div class="row g-4 mb-4">
        <!-- (1) 유저등록 프로토콜 (1102) -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100 border-success">
                <div class="card-header bg-success text-white">
                    <h6 class="mb-0 fw-bold">➕ 유저등록 (UserAddService / Protocol: 1102)</h6>
                </div>
                <div class="card-body">
                    <form id="formUserAdd" class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">UserId (최대 8자)</label>
                            <input type="text" id="addUserId" class="form-control form-control-sm" placeholder="user01" maxlength="8" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Name (닉네임)</label>
                            <input type="text" id="addName" class="form-control form-control-sm" placeholder="용사" maxlength="20" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Password (Pw)</label>
                            <input type="password" id="addPassword" class="form-control form-control-sm" placeholder="비밀번호" maxlength="20" required />
                        </div>
                        <div class="col-12 mt-3">
                            <button type="submit" class="btn btn-sm btn-success w-100">유저등록 요청 (POST /api/UserAddService)</button>
                        </div>
                    </form>
                    <div id="resBoxAdd" class="mt-2 p-2 rounded small d-none"></div>
                </div>
            </div>
        </div>

        <!-- (2) 로그인 프로토콜 (1101) -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100 border-primary">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0 fw-bold">🔐 로그인 (Login / Protocol: 1101)</h6>
                </div>
                <div class="card-body">
                    <form id="formLogin" class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">UserId (최대 8자)</label>
                            <input type="text" id="loginUserId" class="form-control form-control-sm" placeholder="아이디" maxlength="8" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Password</label>
                            <input type="password" id="loginPassword" class="form-control form-control-sm" placeholder="비밀번호" maxlength="20" required />
                        </div>
                        <div class="col-12 mt-3">
                            <button type="submit" class="btn btn-sm btn-primary w-100">로그인 요청 (POST /api/login)</button>
                        </div>
                    </form>
                    <div id="resBoxLogin" class="mt-2 p-2 rounded small d-none"></div>
                </div>
            </div>
        </div>

        <!-- (3) 플레이 유저 정보 (1103) -->
        <div class="col-lg-4">
            <div class="card shadow-sm h-100 border-info">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0 fw-bold">👤 유저 정보 (UserInfoService / Protocol: 1103)</h6>
                </div>
                <div class="card-body">
                    <form id="formUserInfo" class="row g-2">
                        <div class="col-12">
                            <label class="form-label small fw-bold">UserId</label>
                            <input type="text" id="infoUserId" class="form-control form-control-sm" placeholder="아이디 입력" maxlength="8" required />
                        </div>
                        <div class="col-12 mt-3">
                            <button type="submit" class="btn btn-sm btn-info text-white w-100">정보 조회 (POST /api/UserInfoService)</button>
                        </div>
                    </form>
                    <div id="resBoxInfo" class="mt-2 p-2 rounded small d-none"></div>
                </div>
            </div>
        </div>

        <!-- (4) 레벨업 (1104) -->
        <div class="col-lg-4">
            <div class="card shadow-sm h-100 border-warning">
                <div class="card-header bg-warning text-dark">
                    <h6 class="mb-0 fw-bold">⭐ 레벨업 (LevelupService / Protocol: 1104)</h6>
                </div>
                <div class="card-body">
                    <form id="formLevelup" class="row g-2">
                        <div class="col-12">
                            <label class="form-label small fw-bold">UserId</label>
                            <input type="text" id="lvlUserId" class="form-control form-control-sm" placeholder="아이디 입력" maxlength="8" required />
                        </div>
                        <div class="col-12 mt-3">
                            <button type="submit" class="btn btn-sm btn-warning w-100 fw-bold">레벨업 실행 (POST /api/LevelupService)</button>
                        </div>
                    </form>
                    <div id="resBoxLvl" class="mt-2 p-2 rounded small d-none"></div>
                </div>
            </div>
        </div>

        <!-- (5) 골드추가 (1105) -->
        <div class="col-lg-4">
            <div class="card shadow-sm h-100 border-danger">
                <div class="card-header bg-danger text-white">
                    <h6 class="mb-0 fw-bold">💰 골드추가 (AddGoldService / Protocol: 1105)</h6>
                </div>
                <div class="card-body">
                    <form id="formAddGold" class="row g-2">
                        <div class="col-7">
                            <label class="form-label small fw-bold">UserId</label>
                            <input type="text" id="goldUserId" class="form-control form-control-sm" placeholder="아이디" maxlength="8" required />
                        </div>
                        <div class="col-5">
                            <label class="form-label small fw-bold">Gold량</label>
                            <input type="number" id="goldAmount" class="form-control form-control-sm" value="500" required />
                        </div>
                        <div class="col-12 mt-3">
                            <button type="submit" class="btn btn-sm btn-danger w-100">골드추가 (POST /api/AddGoldService)</button>
                        </div>
                    </form>
                    <div id="resBoxGold" class="mt-2 p-2 rounded small d-none"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. 실시간 user_tbl 데이터 테이블 -->
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">📋 [user_tbl] 실시간 데이터베이스 조회</h5>
            <button id="btnRefresh" class="btn btn-sm btn-outline-light">테이블 새로고침</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>User ID</th>
                            <th>Name (닉네임)</th>
                            <th>Password</th>
                            <th>Mobile</th>
                            <th>Level</th>
                            <th>Health</th>
                            <th>Gold</th>
                            <th>가입일 (m_date)</th>
                            <th class="text-center" style="width: 140px;">관리</th>
                        </tr>
                    </thead>
                    <tbody id="userTableBody">
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">데이터를 불러오는 중입니다...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- 사용자 수정 모달 (UPDATE) -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title fw-bold">✏️ 사용자 정보 수정 (UPDATE)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    <div class="mb-2">
                        <label class="form-label fw-bold">user_id (변경불가)</label>
                        <input type="text" id="editUserId" class="form-control bg-light" readonly />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Name (닉네임)</label>
                        <input type="text" id="editName" class="form-control" maxlength="20" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">새 password</label>
                        <input type="text" id="editPassword" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">mobile (최대 11자)</label>
                        <input type="text" id="editMobile" class="form-control" maxlength="11" />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-4">
                            <label class="form-label">level</label>
                            <input type="number" id="editLevel" class="form-control" />
                        </div>
                        <div class="col-4">
                            <label class="form-label">health</label>
                            <input type="number" id="editHealth" class="form-control" />
                        </div>
                        <div class="col-4">
                            <label class="form-label">gold</label>
                            <input type="number" id="editGold" class="form-control" />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">취소</button>
                <button type="button" id="btnSaveEdit" class="btn btn-warning fw-bold">저장 (PUT)</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let editModalInstance = null;
    let usersCache = [];

    function getEditModal() {
        if (!editModalInstance) {
            const el = document.getElementById('editModal');
            if (el && typeof bootstrap !== 'undefined') {
                editModalInstance = new bootstrap.Modal(el);
            }
        }
        return editModalInstance;
    }

    function showResult(boxId, isSuccess, titleText, data) {
        const box = document.getElementById(boxId);
        box.classList.remove('d-none', 'alert-success', 'alert-warning', 'alert-danger');
        box.classList.add('alert', isSuccess ? 'alert-success' : 'alert-danger');
        box.innerHTML = `<strong>${titleText}</strong><pre class="mb-0 mt-1 bg-light p-1 rounded" style="font-size:0.8rem; white-space:pre-wrap;">${JSON.stringify(data, null, 2)}</pre>`;
    }

    // 0. 서버 핑 (/api/ping)
    document.getElementById('btnPing').addEventListener('click', async () => {
        const btn = document.getElementById('btnPing');
        const alertBox = document.getElementById('dbAlert');
        btn.disabled = true;
        btn.innerText = '핑 전송 중...';

        try {
            const res = await fetch('/api/ping?checkDb=true');
            const data = await res.json();
            alertBox.classList.remove('d-none', 'alert-success', 'alert-danger');
            alertBox.classList.add('alert-success');
            alertBox.innerHTML = `<strong>⚡ Ping 응답 성공 (Pong!):</strong> 업타임 <code>${data.uptime}</code> / 서버시각 <code>${data.serverTimeUtc}</code> / DB 상태: <code>${data.database}</code>`;
        } catch (err) {
            alertBox.classList.remove('d-none');
            alertBox.classList.add('alert-danger');
            alertBox.innerText = '❌ 핑 실패: ' + err.message;
        } finally {
            btn.disabled = false;
            btn.innerText = '⚡ 서버 핑 (/api/ping)';
        }
    });

    // 1. DB 연결 확인
    document.getElementById('btnCheckDb').addEventListener('click', async () => {
        const alertBox = document.getElementById('dbAlert');
        try {
            const res = await fetch('/Home/CheckDb');
            const data = await res.json();
            alertBox.classList.remove('d-none', 'alert-success', 'alert-danger');
            if (data.success) {
                alertBox.classList.add('alert-success');
                alertBox.innerText = '✅ ' + data.message;
            } else {
                alertBox.classList.add('alert-danger');
                alertBox.innerText = '❌ ' + data.message;
            }
        } catch (err) {
            alertBox.classList.remove('d-none');
            alertBox.classList.add('alert-danger');
            alertBox.innerText = '❌ 통신 오류: ' + err.message;
        }
    });

    // 2. 유저등록 (1102)
    document.getElementById('formUserAdd').addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = {
            protocol: 1102,
            userId: document.getElementById('addUserId').value.trim(),
            name: document.getElementById('addName').value.trim(),
            password: document.getElementById('addPassword').value
        };

        try {
            const res = await fetch('/api/UserAddService', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            const msg = data.result === 0 ? '🎉 [0] 등록 성공' : (data.result === 1 ? '⚠️ [1] 중복 유저 있음' : '❌ [2] 등록 실패');
            showResult('resBoxAdd', data.result === 0, msg, data);
            if (data.result === 0) loadUsers();
        } catch (err) {
            showResult('resBoxAdd', false, '❌ 통신 오류', { error: err.message });
        }
    });

    // 3. 로그인 (1101)
    document.getElementById('formLogin').addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = {
            protocol: 1101,
            userId: document.getElementById('loginUserId').value.trim(),
            password: document.getElementById('loginPassword').value
        };

        try {
            const res = await fetch('/api/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            const msg = data.result === 0 ? '🎉 [0] 로그인 성공' : (data.result === 1 ? '⚠️ [1] 아이디 없음' : '❌ [2] 비밀번호 불일치');
            showResult('resBoxLogin', data.result === 0, msg, data);
        } catch (err) {
            showResult('resBoxLogin', false, '❌ 통신 오류', { error: err.message });
        }
    });

    // 4. 유저정보 (1103)
    document.getElementById('formUserInfo').addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = {
            protocol: 1103,
            userId: document.getElementById('infoUserId').value.trim()
        };

        try {
            const res = await fetch('/api/UserInfoService', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            const msg = data.result === 0 ? '✅ [0] 유저 정보 조회 성공' : '❌ [1] 조회 실패 (유저 없음)';
            showResult('resBoxInfo', data.result === 0, msg, data);
        } catch (err) {
            showResult('resBoxInfo', false, '❌ 통신 오류', { error: err.message });
        }
    });

    // 5. 레벨업 (1104)
    document.getElementById('formLevelup').addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = {
            protocol: 1104,
            userId: document.getElementById('lvlUserId').value.trim()
        };

        try {
            const res = await fetch('/api/LevelupService', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            const msg = data.result === 0 ? `⭐ [0] 레벨업 성공! (Lv.${data.level})` : '❌ [1] 레벨업 실패';
            showResult('resBoxLvl', data.result === 0, msg, data);
            if (data.result === 0) loadUsers();
        } catch (err) {
            showResult('resBoxLvl', false, '❌ 통신 오류', { error: err.message });
        }
    });

    // 6. 골드추가 (1105)
    document.getElementById('formAddGold').addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = {
            protocol: 1105,
            userId: document.getElementById('goldUserId').value.trim(),
            gold: parseInt(document.getElementById('goldAmount').value) || 0
        };

        try {
            const res = await fetch('/api/AddGoldService', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            const msg = data.result === 0 ? `💰 [0] 골드 추가 성공! (최종: ${data.gold}G)` : '❌ [1] 추가 실패';
            showResult('resBoxGold', data.result === 0, msg, data);
            if (data.result === 0) loadUsers();
        } catch (err) {
            showResult('resBoxGold', false, '❌ 통신 오류', { error: err.message });
        }
    });

    // 7. SELECT 테이블 목록 조회
    async function loadUsers() {
        const tbody = document.getElementById('userTableBody');
        try {
            const res = await fetch('/api/user');
            if (!res.ok) throw new Error('조회 실패');
            usersCache = await res.json();

            if (!usersCache || usersCache.length === 0) {
                tbody.innerHTML = '<tr><td colspan="9" class="text-center py-4 text-muted">등록된 사용자가 없습니다. 위 폼에서 추가해보세요!</td></tr>';
                return;
            }

            tbody.innerHTML = usersCache.map(u => `
                <tr>
                    <td class="fw-bold">${escapeHtml(u.user_id)}</td>
                    <td><span class="badge bg-secondary">${escapeHtml(u.name || '-')}</span></td>
                    <td><code>${escapeHtml(u.password || '')}</code></td>
                    <td>${escapeHtml(u.mobile || '-')}</td>
                    <td><span class="badge bg-info text-dark">Lv.${u.level ?? 1}</span></td>
                    <td>❤️ ${u.health ?? 0}</td>
                    <td>💰 ${u.gold ?? 0}</td>
                    <td>${u.m_date ? u.m_date.substring(0, 10) : '-'}</td>
                    <td class="text-center">
                        <button class="btn btn-sm btn-outline-warning me-1" onclick="openEditModalById('${encodeURIComponent(u.user_id)}')">수정</button>
                        <button class="btn btn-sm btn-outline-danger" onclick="deleteUser('${encodeURIComponent(u.user_id)}')">삭제</button>
                    </td>
                </tr>
            `).join('');
        } catch (err) {
            tbody.innerHTML = `<tr><td colspan="9" class="text-center py-4 text-danger">조회 오류: ${err.message}</td></tr>`;
        }
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function openEditModalById(encodedId) {
        const id = decodeURIComponent(encodedId);
        const user = usersCache.find(x => x.user_id === id);
        if (!user) return alert('사용자 정보를 찾을 수 없습니다.');

        document.getElementById('editUserId').value = user.user_id;
        document.getElementById('editName').value = user.name || '';
        document.getElementById('editPassword').value = user.password || '';
        document.getElementById('editMobile').value = user.mobile || '';
        document.getElementById('editLevel').value = user.level ?? 1;
        document.getElementById('editHealth').value = user.health ?? 100;
        document.getElementById('editGold').value = user.gold ?? 0;

        const modal = getEditModal();
        if (modal) modal.show();
    }

    document.getElementById('btnSaveEdit').addEventListener('click', async () => {
        const id = document.getElementById('editUserId').value;
        const payload = {
            name: document.getElementById('editName').value.trim(),
            password: document.getElementById('editPassword').value,
            mobile: document.getElementById('editMobile').value.replace(/[^0-9]/g, '').substring(0, 11),
            level: parseInt(document.getElementById('editLevel').value) || 1,
            health: parseInt(document.getElementById('editHealth').value) || 100,
            gold: parseInt(document.getElementById('editGold').value) || 0
        };

        try {
            const res = await fetch(`/api/user/${encodeURIComponent(id)}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            if (res.ok) {
                const modal = getEditModal();
                if (modal) modal.hide();
                alert('수정 완료!');
                loadUsers();
            } else {
                alert('수정 실패');
            }
        } catch (err) {
            alert('오류: ' + err.message);
        }
    });

    async function deleteUser(encodedId) {
        const id = decodeURIComponent(encodedId);
        if (!confirm(`'${id}' 사용자를 정말 삭제하시겠습니까?`)) return;

        try {
            const res = await fetch(`/api/user/${encodeURIComponent(id)}`, { method: 'DELETE' });
            if (res.ok) {
                alert('삭제되었습니다.');
                loadUsers();
            } else {
                alert('삭제 실패');
            }
        } catch (err) {
            alert('오류: ' + err.message);
        }
    }

    document.getElementById('btnRefresh').addEventListener('click', loadUsers);
    document.addEventListener('DOMContentLoaded', loadUsers);
</script>
}
