@{
    ViewData["Title"] = "MyNetGame - user_tbl CRUD API";
}

<div class="text-center my-4">
    <h1 class="display-4 fw-bold">🎮 MyNetGame</h1>
    <p class="lead text-muted">Supabase <code>user_tbl</code> CRUD Web API 및 관리 대시보드</p>
</div>

<div class="container my-4">
    <!-- 1. 연결 정보 및 API 가이드 안내 -->
    <div class="alert alert-info d-flex justify-content-between align-items-center mb-4">
        <div>
            <strong>🔗 Web API 엔드포인트:</strong> <code>GET/POST /api/user</code>, <code>GET/PUT/DELETE /api/user/{id}</code>
        </div>
        <button id="btnCheckDb" class="btn btn-sm btn-primary">DB 연결 확인</button>
    </div>
    <div id="dbAlert" class="alert d-none"></div>

    <!-- 2. 신규 사용자 등록 폼 (INSERT) -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="card-title mb-0">➕ 사용자 등록 (INSERT)</h5>
        </div>
        <div class="card-body">
            <form id="insertForm" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label fw-bold">user_id *</label>
                    <input type="text" id="insUserId" class="form-control" placeholder="예: player01" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">password *</label>
                    <input type="password" id="insPassword" class="form-control" placeholder="비밀번호" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">mobile (최대 11자)</label>
                    <input type="text" id="insMobile" class="form-control" placeholder="01012345678" maxlength="11" />
                </div>
                <div class="col-md-1">
                    <label class="form-label">level</label>
                    <input type="number" id="insLevel" class="form-control" value="1" min="1" />
                </div>
                <div class="col-md-1">
                    <label class="form-label">health</label>
                    <input type="number" id="insHealth" class="form-control" value="100" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">gold</label>
                    <input type="number" id="insGold" class="form-control" value="500" />
                </div>
                <div class="col-12 text-end">
                    <button type="submit" id="btnSubmitInsert" class="btn btn-success px-4">사용자 추가 (POST)</button>
                </div>
            </form>
        </div>
    </div>

    <!-- 3. 사용자 목록 조회 (SELECT, UPDATE, DELETE) -->
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">📋 [user_tbl] 실시간 데이터 (SELECT)</h5>
            <button id="btnRefresh" class="btn btn-sm btn-outline-light">새로고침</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>User ID</th>
                            <th>Password</th>
                            <th>Mobile</th>
                            <th>Level</th>
                            <th>Health</th>
                            <th>Gold</th>
                            <th>가입일 (m_date)</th>
                            <th class="text-center" style="width: 160px;">관리</th>
                        </tr>
                    </thead>
                    <tbody id="userTableBody">
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">데이터를 불러오는 중입니다...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- 사용자 수정 모달 (UPDATE) -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title fw-bold">✏️ 사용자 정보 수정 (UPDATE)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    <div class="mb-2">
                        <label class="form-label fw-bold">user_id (변경불가)</label>
                        <input type="text" id="editUserId" class="form-control bg-light" readonly />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">새 password</label>
                        <input type="text" id="editPassword" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">mobile (최대 11자)</label>
                        <input type="text" id="editMobile" class="form-control" maxlength="11" />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-4">
                            <label class="form-label">level</label>
                            <input type="number" id="editLevel" class="form-control" />
                        </div>
                        <div class="col-4">
                            <label class="form-label">health</label>
                            <input type="number" id="editHealth" class="form-control" />
                        </div>
                        <div class="col-4">
                            <label class="form-label">gold</label>
                            <input type="number" id="editGold" class="form-control" />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">취소</button>
                <button type="button" id="btnSaveEdit" class="btn btn-warning fw-bold">저장 (PUT)</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let editModalInstance = null;
    let usersCache = [];

    function getEditModal() {
        if (!editModalInstance) {
            const el = document.getElementById('editModal');
            if (el && typeof bootstrap !== 'undefined') {
                editModalInstance = new bootstrap.Modal(el);
            }
        }
        return editModalInstance;
    }

    // DB 연결 확인
    document.getElementById('btnCheckDb').addEventListener('click', async () => {
        const btn = document.getElementById('btnCheckDb');
        const alertBox = document.getElementById('dbAlert');
        btn.disabled = true;
        btn.innerText = '확인 중...';

        try {
            const res = await fetch('/Home/CheckDb');
            const data = await res.json();
            alertBox.classList.remove('d-none', 'alert-success', 'alert-danger');
            if (data.success) {
                alertBox.classList.add('alert-success');
                alertBox.innerText = '✅ ' + data.message;
            } else {
                alertBox.classList.add('alert-danger');
                alertBox.innerText = '❌ ' + data.message;
            }
        } catch (err) {
            alertBox.classList.remove('d-none');
            alertBox.classList.add('alert-danger');
            alertBox.innerText = '❌ 통신 오류: ' + err.message;
        } finally {
            btn.disabled = false;
            btn.innerText = 'DB 연결 확인';
        }
    });

    // 1. SELECT (목록 조회)
    async function loadUsers() {
        const tbody = document.getElementById('userTableBody');
        try {
            const res = await fetch('/api/user');
            if (!res.ok) {
                const errData = await res.json().catch(() => ({}));
                throw new Error(errData.message || '조회 실패 (상태코드: ' + res.status + ')');
            }
            usersCache = await res.json();

            if (!usersCache || usersCache.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-muted">등록된 사용자가 없습니다. 위 폼에서 추가해보세요!</td></tr>';
                return;
            }

            tbody.innerHTML = usersCache.map(u => `
                <tr>
                    <td class="fw-bold">${escapeHtml(u.user_id)}</td>
                    <td><code>${escapeHtml(u.password || '')}</code></td>
                    <td>${escapeHtml(u.mobile || '-')}</td>
                    <td><span class="badge bg-info text-dark">Lv.${u.level ?? 1}</span></td>
                    <td>❤️ ${u.health ?? 0}</td>
                    <td>💰 ${u.gold ?? 0}</td>
                    <td>${u.m_date ? u.m_date.substring(0, 10) : '-'}</td>
                    <td class="text-center">
                        <button class="btn btn-sm btn-outline-warning me-1" onclick="openEditModalById('${encodeURIComponent(u.user_id)}')">수정</button>
                        <button class="btn btn-sm btn-outline-danger" onclick="deleteUser('${encodeURIComponent(u.user_id)}')">삭제</button>
                    </td>
                </tr>
            `).join('');
        } catch (err) {
            tbody.innerHTML = `<tr><td colspan="8" class="text-center py-4 text-danger">조회 오류: ${err.message}</td></tr>`;
        }
    }

    // HTML 특수문자 이스케이프 함수
    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    // 2. INSERT (추가)
    document.getElementById('insertForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById('btnSubmitInsert');
        btn.disabled = true;
        btn.innerText = '등록 중...';

        const payload = {
            user_id: document.getElementById('insUserId').value.trim(),
            password: document.getElementById('insPassword').value,
            mobile: document.getElementById('insMobile').value.replace(/[^0-9]/g, '').substring(0, 11),
            level: parseInt(document.getElementById('insLevel').value) || 1,
            health: parseInt(document.getElementById('insHealth').value) || 100,
            gold: parseInt(document.getElementById('insGold').value) || 0
        };

        try {
            const res = await fetch('/api/user', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json().catch(() => ({}));
            if (res.ok) {
                alert('✅ 사용자가 성공적으로 등록되었습니다!');
                document.getElementById('insertForm').reset();
                document.getElementById('insLevel').value = 1;
                document.getElementById('insHealth').value = 100;
                document.getElementById('insGold').value = 500;
                loadUsers();
            } else {
                alert('❌ 등록 실패: ' + (data.message || data.error || '알 수 없는 오류'));
            }
        } catch (err) {
            alert('❌ 통신 오류: ' + err.message);
        } finally {
            btn.disabled = false;
            btn.innerText = '사용자 추가 (POST)';
        }
    });

    // 3. UPDATE 모달 열기 및 수정
    function openEditModalById(encodedId) {
        const id = decodeURIComponent(encodedId);
        const user = usersCache.find(x => x.user_id === id);
        if (!user) {
            alert('사용자 정보를 찾을 수 없습니다.');
            return;
        }

        document.getElementById('editUserId').value = user.user_id;
        document.getElementById('editPassword').value = user.password || '';
        document.getElementById('editMobile').value = user.mobile || '';
        document.getElementById('editLevel').value = user.level ?? 1;
        document.getElementById('editHealth').value = user.health ?? 100;
        document.getElementById('editGold').value = user.gold ?? 0;

        const modal = getEditModal();
        if (modal) {
            modal.show();
        } else {
            alert('모달 컴포넌트를 초기화하지 못했습니다.');
        }
    }

    document.getElementById('btnSaveEdit').addEventListener('click', async () => {
        const id = document.getElementById('editUserId').value;
        const btn = document.getElementById('btnSaveEdit');
        btn.disabled = true;
        btn.innerText = '저장 중...';

        const payload = {
            password: document.getElementById('editPassword').value,
            mobile: document.getElementById('editMobile').value.replace(/[^0-9]/g, '').substring(0, 11),
            level: parseInt(document.getElementById('editLevel').value) || 1,
            health: parseInt(document.getElementById('editHealth').value) || 100,
            gold: parseInt(document.getElementById('editGold').value) || 0
        };

        try {
            const res = await fetch(`/api/user/${encodeURIComponent(id)}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json().catch(() => ({}));
            if (res.ok) {
                const modal = getEditModal();
                if (modal) modal.hide();
                alert('✅ 수정 완료!');
                loadUsers();
            } else {
                alert('❌ 수정 실패: ' + (data.message || data.error || '수정 실패'));
            }
        } catch (err) {
            alert('❌ 통신 오류: ' + err.message);
        } finally {
            btn.disabled = false;
            btn.innerText = '저장 (PUT)';
        }
    });

    // 4. DELETE (삭제)
    async function deleteUser(encodedId) {
        const id = decodeURIComponent(encodedId);
        if (!confirm(`정말로 '${id}' 사용자를 삭제하시겠습니까?`)) return;

        try {
            const res = await fetch(`/api/user/${encodeURIComponent(id)}`, {
                method: 'DELETE'
            });
            const data = await res.json().catch(() => ({}));
            if (res.ok) {
                alert('✅ 삭제되었습니다.');
                loadUsers();
            } else {
                alert('❌ 삭제 실패: ' + (data.message || data.error || '삭제 실패'));
            }
        } catch (err) {
            alert('❌ 통신 오류: ' + err.message);
        }
    }

    document.getElementById('btnRefresh').addEventListener('click', loadUsers);
    
    // 페이지 로드 완료 시 사용자 목록 조회
    document.addEventListener('DOMContentLoaded', () => {
        loadUsers();
    });
</script>
}
